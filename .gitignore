# 构建产物
build/
dist/
# PyInstaller 在仓库根目录生成的 .app 副产物（打包时向后兼容旧习惯生成的，
# 实际交付物是根目录的 *.zip；绝不进 git）
MiteProxy.app/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# 测试
.pytest_cache/

# 本地 CA 私钥：绝不能进仓库（首次运行自动重新生成）
certs/
*.pem
.DS_Store

# 打包产物压缩包（进 GitHub Release，不进 git）
*.zip

# WorkBuddy 工作记忆（含私人背景，不进仓库）
.workbuddy/

# 构建/打包日志
*.log

# 教程派生导出件（源文件是 TUTORIAL.md，HTML 仅供贴 Confluence，按需本地生成）
TUTORIAL.html
TUTORIAL-confluence.html
